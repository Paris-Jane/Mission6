@{
    ViewData["Title"] = "About";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
    }
    
    .minimal-border {
        border: 1px solid #e9ecef;
    }
    
    .btn-outline-dark:hover {
        background-color: #212529;
        color: white;
    }
</style>

<div class="container py-5">
    <!-- Header -->
    <div class="row justify-content-center text-center mb-5">
        <div class="col-lg-8">
            <h1 class="display-4 fw-light mb-3">Joel Hilton</h1>
            <p class="text-muted fs-5">Film Enthusiast & Collector</p>
        </div>
    </div>

    <!-- About Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <h2 class="h5 fw-normal mb-4">About This Site</h2>
            <p class="lead fw-light text-muted mb-4">
                This is my Joel Hiltons movie catalog—a digital collection where he can track, organize, and celebrate the films I've watched over the years.
            </p>
            <p class="fw-light text-muted mb-4">
                With a background in Film Studies from BYU and experience as a movie reviewer for ClearPlay, Joel developed a deep appreciation for cinema. This website serves as his central hub to add new movies to my collection, browse what he has seen, and keep my ever-growing catalog organized.
            </p>
        </div>
    </div>

    <!-- Image -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <a href="https://baconsale.com/" target="_blank" class="d-block">
                <img src="~/img/BaconsaleKate.jpg" alt="The Baconsale Team" class="img-fluid minimal-border" />
            </a>
        </div>
    </div>

    <!-- Beyond Movies Section -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <h2 class="h5 fw-normal mb-4">Beyond Movies</h2>
            <p class="fw-light text-muted mb-4">
                When he is not cataloging films, he co-host <strong>Baconsale</strong>, a weekly podcast where people discuss movies, music, TV, food, and video games.
            </p>
            <p class="fw-light text-muted mb-0">
                He also performs with <strong>Quick Wits</strong>, Utah's improvisational comedy troupe, where they create spontaneous comedy from audience suggestions. He's been with the group since 2001.
            </p>
        </div>
    </div>

    <!-- Links -->
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex gap-3 flex-wrap">
                <a href="https://baconsale.com/" target="_blank" class="btn btn-outline-dark">
                    Baconsale Podcast
                </a>
                <a href="https://www.qwcomedy.com/" target="_blank" class="btn btn-outline-dark">
                    Quick Wits Comedy
                </a>
            </div>
        </div>
    </div>
</div>
