@{
    ViewData["Title"] = "Add Movie";
}

@model Movie

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h1 class="display-5 fw-light">Add a Movie</h1>
                <p class="text-muted">Add to Hilton's collection</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post">
                        <input type="hidden" asp-for="MovieId" />

                        <!-- Title (Required) -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter movie title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Year (Required) -->
                        <div class="mb-3">
                            <label asp-for="Year" class="form-label">Year <span class="text-danger">*</span></label>
                            <input asp-for="Year" type="number" class="form-control" placeholder="2024" />
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>

                        <hr class="my-4">
                        <h6 class="text-muted mb-3 fw-normal">Optional Information</h6>

                        <!-- Rating -->
                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label">Rating</label>
                            <select asp-for="Rating" class="form-select">
                                <option value="">Select rating...</option>
                                <option value="G">G</option>
                                <option value="PG">PG</option>
                                <option value="PG-13">PG-13</option>
                                <option value="R">R</option>
                                <option value="NR">Not Rated</option>
                            </select>
                        </div>

                        <!-- Director -->
                        <div class="mb-3">
                            <label asp-for="Director" class="form-label">Director</label>
                            <input asp-for="Director" class="form-control" placeholder="Director name" />
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="CategoryID" class="form-label">Category</label>
                            <select asp-for="CategoryID" class="form-select">
                                <option value="">Select category...</option>
                                @foreach (Category c in ViewBag.Category)
                                {
                                    <option value="@c.CategoryID">@c.CategoryName</option>
                                }
                            </select>
                        </div>

                        <!-- Lent To -->
                        <div class="mb-3">
                            <label asp-for="LentTo" class="form-label">Lent To</label>
                            <input asp-for="LentTo" class="form-control" placeholder="Person's name" />
                        </div>

                        <!-- Notes -->
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <input asp-for="Notes" class="form-control" maxlength="25" placeholder="Add a note (max 25 characters)" />
                            <div class="form-text">Maximum 25 characters</div>
                        </div>

                        <hr class="my-4">
                        <h6 class="text-muted mb-3 fw-normal">Required Flags</h6>

                        <!-- Edited (Required) -->
                        <div class="mb-3">
                            <label asp-for="Edited" class="form-label">Edited <span class="text-danger">*</span></label>
                            <select asp-for="Edited" class="form-select">
                                <option value="">Select...</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                            <span asp-validation-for="Edited" class="text-danger small"></span>
                        </div>

                        <!-- Copied to Plex (Required) -->
                        <div class="mb-4">
                            <label asp-for="CopiedToPlex" class="form-label">Copied to Plex <span class="text-danger">*</span></label>
                            <select asp-for="CopiedToPlex" class="form-select">
                                <option value="">Select...</option>
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </select>
                            <span asp-validation-for="CopiedToPlex" class="text-danger small"></span>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg">Add to Collection</button>
                        </div>
                        <small class="text-muted d-block text-center mt-2"><span class="text-danger">*</span> Required fields</small>

                        <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>