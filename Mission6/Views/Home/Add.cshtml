@{
    ViewData["Title"] = "Add Movie";
}

@model Application

<style>
    body {
        font-family: 'Inter', sans-serif;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center mb-4">
                <h1 class="display-5 fw-light">Add a Movie</h1>
                <p class="text-muted">Add to Hilton's collection</p>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post">
                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-normal">Title *</label>
                            <input asp-for="Title" class="form-control" required placeholder="Enter movie title">
                        </div>

                        <!-- Year and Rating -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Year" class="form-label fw-normal">Year *</label>
                                <input asp-for="Year" type="number" class="form-control" required min="1888" max="2050" placeholder="2024">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Rating" class="form-label fw-normal">Rating *</label>
                                <select asp-for="Rating" class="form-select" required>
                                    <option value="">Select rating...</option>
                                    <option value="G">G</option>
                                    <option value="PG">PG</option>
                                    <option value="PG-13">PG-13</option>
                                    <option value="R">R</option>
                                    <option value="NR">Not Rated</option>
                                </select>
                            </div>
                        </div>

                        <!-- Director -->
                        <div class="mb-3">
                            <label asp-for="Director" class="form-label fw-normal">Director *</label>
                            <input asp-for="Director" class="form-control" required placeholder="Director name">
                        </div>

                        <!-- Category (Full Width) -->
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-normal">Category *</label>
                            <select asp-for="Category" class="form-select" required>
                                <option value="">Select category...</option>
                                <option value="Action/Adventure">Action/Adventure</option>
                                <option value="Comedy">Comedy</option>
                                <option value="Drama">Drama</option>
                                <option value="Family">Family</option>
                                <option value="Horror/Suspense">Horror/Suspense</option>
                                <option value="Miscellaneous">Miscellaneous</option>
                                <option value="Television">Television</option>
                                <option value="VHS">VHS</option>
                            </select>
                        </div>

                        <hr class="my-4">

                        <!-- Optional Fields Section -->
                        <h6 class="text-muted mb-3 fw-normal">Optional Information</h6>

                        <!-- Edited and Lent To -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check mt-4">
                                    <input asp-for="Edited" class="form-check-input" type="checkbox">
                                    <label asp-for="Edited" class="form-check-label fw-normal">
                                        Edited
                                    </label>
                                </div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Lent" class="form-label fw-normal">Lent To</label>
                                <input asp-for="Lent" class="form-control" placeholder="Person's name">
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-normal">Notes</label>
                            <input asp-for="Notes" class="form-control" maxlength="25" placeholder="Add a note (max 25 characters)">
                            <div class="form-text">Maximum 25 characters</div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-dark btn-lg">Add to Collection</button>
                            <small class="text-muted text-center mt-2">* Required fields</small>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
