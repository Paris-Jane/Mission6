@{
    ViewData["Title"] = "Catalog";
}

@model List<Application>

<style>
    body {
        font-family: 'Inter', sans-serif;
    }
</style>

            <div class="text-center mb-4">
                <h1 class="display-5 fw-light">Add a Movie</h1>
                <p class="text-muted">Add to Hilton's collection</p>
            </div>

<table class="table table-bordered">
    <thead class="fw-bold">
        <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Year</th>
            <th>Rating</th>
            <th>Director</th>
            <th>Edited</th>
            <th>Lent</th>
            <th>Notes</th> 
        </tr>
    </thead>
    
    @foreach (var a in Model)
    {
        <tbody>
            <tr>
                <td>@a.Title</td>
                <td>@a.Category</td>
                <td>@a.Year</td>
                <td>@a.Rating</td>
                <td>@a.Director</td>
                <td>@a.Edited</td>
                <td>@a.Lent</td>
                <td>@a.Notes</td>
            </tr>
        </tbody>  
    }
    
</table>

